# Copy to .env — `mealie setup` does this and fills in BASE_URL for you.
# .env is ignored by git, so passwords put here never get committed.

# Ports on the laptop. Open http://localhost:<port> in a browser.
MEALIE_PORT=9925
GROCY_PORT=9283
ACTUAL_PORT=5006
# Bank sync page, http://localhost:8787 (this laptop only).
BRIDGE_PORT=8787
TZ=America/New_York

# The address other devices use to reach Mealie (setup sets this to the
# laptop's Wi-Fi address, e.g. http://192.168.1.23:9925).
BASE_URL=http://localhost:9925

ALLOW_SIGNUP=false

# Backups (all three apps): folder to save them in. Blank = OneDrive\MealieBackups
# (or .\backups if OneDrive isn't set up). BACKUP_KEEP = how many to keep per app.
BACKUP_DIR=
BACKUP_KEEP=8
# Optional second copy off the laptop (same BACKUP_KEEP), e.g. your personal
# Google Drive via Google Drive for desktop: G:\My Drive\MealieBackups
BACKUP_COPY_DIR=

# Bank sync (kitchen bridge, ADR-22). Leave blank until Plaid approves your
# Trial plan; the bridge stays idle until all four required values are set.
# Plaid dashboard > Developers > Keys: client_id and the Production secret.
PLAID_CLIENT_ID=
PLAID_SECRET=
# production for your real bank; sandbox to test with Plaid's fake banks.
PLAID_ENV=production
# Only if your bank sends you to its own site to log in (OAuth); see README.
PLAID_REDIRECT_URI=
# The Actual Budget server password, and the budget's Sync ID
# (Actual: Settings > Show advanced settings > Sync ID).
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
# Only if you turned on end-to-end encryption in Actual.
ACTUAL_BUDGET_PASSWORD=
# Hour of the day (0-23) the daily bank sync runs.
BANK_SYNC_HOUR=6

# Optional email via Gmail: create an app password at
# https://support.google.com/accounts/answer/185833 and fill these in.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
