{
  "name": "@kitchen/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-database": {
      "types": "./dist/test-database.d.ts",
      "default": "./dist/test-database.js"
    }
  },
  "bin": {
    "kitchen-migrate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node dist/cli.js",
    "import:mealie": "pnpm run build && node dist/import-mealie.js"
  },
  "dependencies": {
    "mssql": "12.7.16"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "@types/node": "26.6.6"
  },
  "files": [
    "dist",
    "migrations"
  ]
}
