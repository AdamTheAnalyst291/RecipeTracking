# Copy to .env — `mealie setup` does this and fills in BASE_URL for you.
# .env is ignored by git, so passwords put here never get committed.

# Port on the laptop. Open http://localhost:9925 in a browser.
MEALIE_PORT=9925
TZ=America/New_York

# The address other devices use to reach Mealie (setup sets this to the
# laptop's Wi-Fi address, e.g. http://192.168.1.23:9925).
BASE_URL=http://localhost:9925

ALLOW_SIGNUP=false

# Backups: folder to save them in. Blank = OneDrive\MealieBackups
# (or .\backups if OneDrive isn't set up). BACKUP_KEEP = how many to keep.
BACKUP_DIR=
BACKUP_KEEP=8

# Optional email via Gmail: create an app password at
# https://support.google.com/accounts/answer/185833 and fill these in.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
